    <!-- http://purl.obolibrary.org/obo/GO_0045275 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0045275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0044424"/>
