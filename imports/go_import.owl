        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#gosubset_prok"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that this term represents an activity and not a gene product. Consider also annotating to the molecular function terms &apos;glutamate-gated ion channel activity ; GO:0005234&apos; and &apos;cation channel activity ; GO:0005261&apos;.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ionotropic glutamate receptor activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0004970"/>
