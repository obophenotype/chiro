    <!-- http://purl.obolibrary.org/obo/GO_0045276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0045276">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
