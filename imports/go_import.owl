    <!-- http://purl.obolibrary.org/obo/GO_0004971 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0004971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0004970"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ionotropic glutamate receptor activity that exhibits fast gating by glutamate and acts by opening a cation channel permeable to sodium, potassium, and, in the absence of a GluR2 subunit, calcium.</obo:IAO_0000115>
