        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase in the internal diameter of blood vessels, especially arterioles or capillaries, usually resulting in a decrease in blood pressure contributing to an acute inflammatory response.</obo:IAO_0000115>
