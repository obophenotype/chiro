    <!-- http://purl.obolibrary.org/obo/GO_0003707 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0003707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0038023"/>
