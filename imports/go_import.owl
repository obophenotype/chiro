    <!-- http://purl.obolibrary.org/obo/GO_0045125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0045125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0004930"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Combining with a bioactive lipid and transmitting the signal across the membrane by activating an associated G-protein; promotes the exchange of GDP for GTP on the alpha subunit of a heterotrimeric G-protein complex. A bioactive lipid is a lipid for which changes in lipid levels result in functional consequences in a variety of cellular processes.</obo:IAO_0000115>
